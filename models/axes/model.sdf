<?xml version="1.0"?>
<sdf version="1.6">
  <model name="axes">
    <static>true</static>

    <link name="axes_link">
      <visual name="x_axis">
        <cast_shadows>0</cast_shadows>
        <pose>1 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>2 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <emissive>1 0 0 1</emissive>
          <specular>1 1 1 1</specular>
        </material>
      </visual>

      <visual name="y_axis">
        <cast_shadows>0</cast_shadows>
        <pose>0 1 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 2 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
          <emissive>0 1 0 1</emissive>
          <specular>1 1 1 1</specular>
        </material>
      </visual>

      <visual name="z_axis">
        <cast_shadows>0</cast_shadows>
        <pose>0 0 1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.04 2</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <emissive>0 0 1 1</emissive>
          <specular>1 1 1 1</specular>
        </material>
      </visual>
      
      <visual name="x_text_visual">
        <pose>2 0.25 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.5 0.5</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://axes/images/X.png</albedo_map>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="y_text_visual">
        <pose>0.25 2 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.5 0.5</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://axes/images/Y.png</albedo_map>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="x_text_reverse_visual">
        <pose>2 0.25 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 -1</normal>
            <size>0.5 0.5</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://axes/images/X.png</albedo_map>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="y_text_reverse_visual">
        <pose>0.25 2 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 -1</normal>
            <size>0.5 0.5</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://axes/images/Y.png</albedo_map>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="z_text_visual">
        <pose>0.25 0 2 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 1 0</normal>
            <size>0.5 0.5</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://axes/images/Z.png</albedo_map>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="z_text_reverse_visual">
        <pose>0.25 0 2 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 -1 0</normal>
            <size>0.5 0.5</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://axes/images/Z.png</albedo_map>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
